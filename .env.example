# Copiá API URL y publishable/anon key de: npx supabase status
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-after-supabase-start

# Pedíselos a Agus. El secret tiene que ser el mismo en las tres.
GOOGLE_CLIENT_ID=
# Next lo usa para renovar el access token de Drive.
GOOGLE_CLIENT_SECRET=
# Auth local (supabase/config.toml → env SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET)
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
